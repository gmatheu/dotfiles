function yy() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

## Sesh zsh plugin
function sesh-switch() {
  sesh connect $(
    sesh list -t --icons | fzf-tmux -p 55%,60% \
      --no-sort --ansi --border-label ' sesh ' --prompt '⚡  ' \
      --header '  ^a all ^t tmux ^g configs ^x zoxide ^d tmux kill ^f find' \
      --bind 'tab:down,btab:up' \
      --bind 'ctrl-a:change-prompt(⚡  )+reload(sesh list --icons)' \
      --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list -t --icons)' \
      --bind 'ctrl-g:change-prompt(⚙<fe0f>  )+reload(sesh list -c --icons)' \
      --bind 'ctrl-x:change-prompt(📁  )+reload(sesh list -z --icons)' \
      --bind 'ctrl-f:change-prompt(🔎  )+reload(fd -H -d 2 -t d -E .Trash . ~)' \
      --bind 'ctrl-d:execute(tmux kill-session -t {2..})+change-prompt(⚡  )+reload(sesh list --icons)'
  )
}

function sesh-last() {
  sesh last
}
## end: Sesh zsh plugin

## Git zsh plugin
function git_current_branch() { git branch --show-current; }


function __git_last_commit() { print -z "git commit -m \"$(git log -1 --pretty=%B)\"" }
alias glc=__git_last_commit

function __git_branch_local_switch () {
  _fzf_git_branches | xargs git checkout
}
alias gbs=__git_branch_local_switch


function __git_branch_remote_switch () {git branch --remotes --list --sort=-creatordate | cut -d '/' -f 2- | grep -v 'HEAD' | grep -v 'main' | fzf --bind='enter:become(git checkout {})'}
alias gbr=__git_branch_remote_switch
## end: git

## Zellij zsh plugin
if command -v zellij >/dev/null; then
  # source <(zellij setup --generate-completion zsh)
  function zellij_rename_session() {
    zellij action rename-session $(basename $PWD)
  }
  function zellij_restore_session() {
    zellij list-sessions -n -s | fzf --bind='enter:become(zellij attach {})'
  }
  function zellij_rename_tab_git() {
    zellij action undo-rename-tab
    local current_tab
    current_tab=$(zellij action dump-layout | grep -e 'tab' | grep -e 'focus=true' | grep -e '#.' -o)
    local current_branch
    current_branch=$(git branch --show-current)

    zellij action rename-tab "$current_tab:$current_branch"
  }
  alias zj=zellij
  alias zjR=zellij_rename_session
  alias zjr=zellij_restore_session
  alias zjg=zellij_rename_tab_git
fi
## end:Zellij zsh plugin
